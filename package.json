{
  "name": "pc-ports",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A curated, searchable catalog of unofficial native ports of console games.",
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "fetch": "node scripts/fetch-github.mjs",
    "discover": "node scripts/discover.mjs",
    "dev": "astro dev",
    "build": "node scripts/validate-data.mjs && node scripts/fetch-github.mjs && astro build",
    "build:offline": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.4",
    "satori": "^0.56.1"
  },
  "overrides": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
