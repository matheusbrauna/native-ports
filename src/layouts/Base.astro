---
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "../styles/global.css";
import { fetchedAt, type Lang } from "../lib/catalog";
import { t, path, stripLang, locale, formatDate } from "../lib/i18n";
import { ogPath, websiteLd } from "../lib/seo";

interface Props {
  lang: Lang;
  /** Short page name; rendered as "name · Native Ports". */
  title?: string;
  /** Complete <title>, used as is (it already names the site or leads with the search term). */
  fullTitle?: string;
  description?: string;
  active?: "catalog" | "submit" | "about";
  /** JSON-LD objects for this page; the WebSite object is added on the home page. */
  jsonLd?: object[];
  noindex?: boolean;
  ogType?: "website" | "article";
}
const { lang, title, fullTitle, description, active, jsonLd = [], noindex = false, ogType = "website" } = Astro.props;
const s = t[lang];
const pageTitle = fullTitle ?? (title ? `${title} · ${s.siteName}` : s.siteName);
const desc = description ?? s.siteDescription;
const rest = stripLang(Astro.url.pathname);
const other: Lang = lang === "en" ? "pt-br" : "en";
const site = Astro.site ?? new URL("http://localhost:4321");
const siteRepo = import.meta.env.PUBLIC_SITE_REPO || process.env.GITHUB_REPOSITORY;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(ogPath(rest, lang), site).href;
const isHome = rest === "/";
const ld = [...(isHome ? [websiteLd(lang, site)] : []), ...jsonLd];
---
<!doctype html>
<html lang={locale[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#16181d" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(path(rest, "en"), site)} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(path(rest, "pt-br"), site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(path(rest, "en"), site)} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <meta property="og:site_name" content="Native Ports" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "pt_BR"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "pt_BR" : "en_US"} />
    {!noindex && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={pageTitle} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href={path("/", lang)}>
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <rect x="1" y="3" width="20" height="3" rx="1" fill="var(--ink)" />
            <rect x="1" y="9.5" width="14" height="3" rx="1" fill="var(--ink-2)" />
            <rect x="1" y="16" width="8" height="3" rx="1" fill="var(--ink-3)" />
          </svg>
          <span>{s.siteName}</span>
        </a>
        <nav aria-label="Primary">
          <a href={path("/", lang)} aria-current={active === "catalog" ? "page" : undefined}>{s.nav.catalog}</a>
          <a href={path("/submit/", lang)} aria-current={active === "submit" ? "page" : undefined}>{s.nav.submit}</a>
          <a href={path("/about/", lang)} aria-current={active === "about" ? "page" : undefined}>{s.nav.about}</a>
        </nav>
        <a class="lang" href={path(rest, other)} hreflang={locale[other]} lang={locale[other]}>
          <span class="lang-code">{other === "en" ? "EN" : "PT"}</span><span class="lang-name">{s.otherLang}</span>
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-in">
        <div class="promise">
          <p><strong>{s.footer.noFilesLead}</strong> {s.footer.noFiles}</p>
          <p><strong>{s.footer.disclaimerLead}</strong> {s.footer.disclaimer}</p>
        </div>
        <nav class="foot-nav" aria-label={s.footer.navLabel}>
          <ul>
            <li><a href={path("/submit/", lang)} aria-current={active === "submit" ? "page" : undefined}>{s.nav.submit}</a></li>
            <li><a href={path("/about/", lang)} aria-current={active === "about" ? "page" : undefined}>{s.nav.about}</a></li>
            <li><a href={path(rest, other)} hreflang={locale[other]} lang={locale[other]}>{s.otherLang}</a></li>
            {siteRepo && <li><a href={`https://github.com/${siteRepo}`}>{s.footer.source}</a></li>}
          </ul>
        </nav>
        <p class="meta">
          {fetchedAt
            ? <span>{s.footer.updated} <time class="data" datetime={fetchedAt}>{formatDate(fetchedAt, lang)}</time></span>
            : <span>{s.footer.notFetched}</span>}
          <span class="licenses">
            {siteRepo
              ? <><a href={`https://github.com/${siteRepo}/blob/main/LICENSE`}>{s.footer.code} MIT</a><span aria-hidden="true">·</span><a href={`https://github.com/${siteRepo}/blob/main/data/LICENSE.md`}>{s.footer.data} CC BY 4.0</a></>
              : <>{s.footer.code} MIT<span aria-hidden="true">·</span>{s.footer.data} CC BY 4.0</>}
          </span>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .top { border-bottom: 1px solid var(--line); background: var(--ground); }
  .top-in { display: flex; align-items: center; gap: 28px; height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 700; font-size: var(--step-1); }
  .brand:hover { color: var(--ink); }
  .top nav { display: flex; gap: 4px; margin-left: auto; }
  .top nav a {
    color: var(--ink-2); text-decoration: none; padding: 6px 10px; border-radius: var(--radius);
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .top nav a:hover { color: var(--ink); background: var(--panel); }
  .top nav a[aria-current="page"] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--link); border-radius: 0; }
  .lang {
    display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); text-decoration: none;
    padding: 5px 10px; border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: var(--step--1);
  }
  .lang:hover { color: var(--ink); background: var(--panel); }
  .lang-code { font-family: var(--font-data); font-weight: 600; color: var(--ink); }
  main { flex: 1; outline: none; }
  .foot { border-top: 1px solid var(--line); margin-top: 64px; color: var(--ink-3); font-size: var(--step--1); }
  .foot-in {
    padding-block: 32px 36px; max-width: 1360px;
    display: grid; grid-template-columns: minmax(0, var(--measure)) auto; justify-content: space-between; gap: 28px 48px;
  }
  .foot a { color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .foot a:hover { color: var(--ink); text-decoration-color: currentColor; }

  .promise { display: grid; gap: 10px; color: var(--ink-2); font-size: var(--step-0); }
  .promise strong { color: var(--ink); }

  .foot-nav ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; justify-items: end; }
  .foot-nav a { display: inline-block; padding-block: 4px; text-decoration: none; }
  .foot-nav a:hover { text-decoration: underline; }
  .foot-nav a[aria-current="page"] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--link); }

  .meta {
    grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 24px;
    padding-top: 16px; border-top: 1px solid var(--line);
  }
  .meta .data { color: var(--ink-2); white-space: nowrap; }
  .licenses { display: inline-flex; flex-wrap: wrap; gap: 8px; }

  @media (max-width: 720px) {
    .top-in { height: auto; flex-wrap: wrap; gap: 6px 16px; padding-block: 12px 4px; }
    .top nav { order: 3; margin-left: -10px; width: 100%; overflow-x: auto; }
    .foot-in { grid-template-columns: minmax(0, 1fr); }
    .foot-nav ul { justify-items: start; gap: 0; }
    .foot-nav a { display: flex; align-items: center; min-height: 44px; }
    .meta { flex-direction: column; }
    .lang { margin-left: auto; }
    .lang-name { display: none; }
  }
</style>
