---
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "../styles/global.css";
import { fetchedAt, type Lang } from "../lib/catalog";
import { t, path, stripLang, locale, formatDate } from "../lib/i18n";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  active?: "catalog" | "submit" | "about";
}
const { lang, title, description, active } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} · ${s.siteName}` : s.siteName;
const desc = description ?? s.siteDescription;
const rest = stripLang(Astro.url.pathname);
const other: Lang = lang === "en" ? "pt-br" : "en";
const site = Astro.site ?? new URL("http://localhost:4321");
const siteRepo = import.meta.env.PUBLIC_SITE_REPO || process.env.GITHUB_REPOSITORY;
---
<!doctype html>
<html lang={locale[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#16181d" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    <link rel="alternate" hreflang="en" href={new URL(path(rest, "en"), site)} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(path(rest, "pt-br"), site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(path(rest, "en"), site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "pt_BR"} />
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href={path("/", lang)}>
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <rect x="1" y="3" width="20" height="3" rx="1" fill="var(--ink)" />
            <rect x="1" y="9.5" width="14" height="3" rx="1" fill="var(--ink-2)" />
            <rect x="1" y="16" width="8" height="3" rx="1" fill="var(--ink-3)" />
          </svg>
          <span>{s.siteName}</span>
        </a>
        <nav aria-label="Primary">
          <a href={path("/", lang)} aria-current={active === "catalog" ? "page" : undefined}>{s.nav.catalog}</a>
          <a href={path("/submit/", lang)} aria-current={active === "submit" ? "page" : undefined}>{s.nav.submit}</a>
          <a href={path("/about/", lang)} aria-current={active === "about" ? "page" : undefined}>{s.nav.about}</a>
        </nav>
        <a class="lang" href={path(rest, other)} hreflang={locale[other]} lang={locale[other]}>
          <span class="lang-code">{other === "en" ? "EN" : "PT"}</span><span class="lang-name">{s.otherLang}</span>
        </a>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-in">
        <p>{s.footer.noFiles}</p>
        <p>{s.footer.disclaimer}</p>
        <p class="meta">
          <span>{s.footer.updated} <time datetime={fetchedAt ?? undefined}>{fetchedAt ? formatDate(fetchedAt, lang) : s.footer.never}</time></span>
          {siteRepo && <a href={`https://github.com/${siteRepo}`}>{s.footer.source}</a>}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .top { border-bottom: 1px solid var(--line); background: var(--ground); }
  .top-in { display: flex; align-items: center; gap: 28px; height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 700; font-size: var(--step-1); }
  .brand:hover { color: var(--ink); }
  nav { display: flex; gap: 4px; margin-left: auto; }
  nav a {
    color: var(--ink-2); text-decoration: none; padding: 6px 10px; border-radius: var(--radius);
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  nav a:hover { color: var(--ink); background: var(--panel); }
  nav a[aria-current="page"] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--link); border-radius: 0; }
  .lang {
    display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); text-decoration: none;
    padding: 5px 10px; border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: var(--step--1);
  }
  .lang:hover { color: var(--ink); background: var(--panel); }
  .lang-code { font-family: var(--font-data); font-weight: 600; color: var(--ink); }
  main { flex: 1; outline: none; }
  .foot { border-top: 1px solid var(--line); margin-top: 64px; color: var(--ink-3); font-size: var(--step--1); }
  .foot-in { padding-block: 28px 36px; display: grid; gap: 8px; max-width: 1360px; }
  .foot p { max-width: var(--measure); }
  .foot .meta { display: flex; flex-wrap: wrap; gap: 16px; }
  .foot a { color: var(--ink-2); }

  @media (max-width: 720px) {
    .top-in { height: auto; flex-wrap: wrap; gap: 6px 16px; padding-block: 12px 4px; }
    nav { order: 3; margin-left: -10px; width: 100%; overflow-x: auto; }
    .lang { margin-left: auto; }
    .lang-name { display: none; }
  }
</style>
