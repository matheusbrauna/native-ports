{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker: the Astro build in dist/ is served as is, with no Worker script.
  "name": "native-ports",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "ports.matheusbrauna.com.br", "custom_domain": true }
  ],
  // Only the custom domain serves the site, so search engines never see a duplicate copy.
  "workers_dev": false,
  "preview_urls": false
}
